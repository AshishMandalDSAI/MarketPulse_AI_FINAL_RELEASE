# MarketPulse AI - Environment Variables Template
#
# SETUP:  cp .env.example .env   then fill in real values below.
# .env is gitignored and dockerignored — never commit it.
# docker-compose reads from .env (not this file).

# Optional: enables LLM-assisted narrative answers in the AI Marketing Analyst.
# The application works fully offline in "Demo AI Mode" without this key.
ANTHROPIC_API_KEY=

# Optional: override the SQLite database path (defaults to data/processed/marketpulse.db)
DATABASE_PATH=data/processed/marketpulse.db

# Optional: FastAPI server host/port (used by uvicorn if you customize the run command)
API_HOST=127.0.0.1
API_PORT=8000

# Optional: Streamlit server port
STREAMLIT_PORT=8501

# Optional: API key for securing API endpoints. When set, write and compute
# endpoints (upload, confirm, optimize, simulate, ask, decisions/run) require
# an X-API-Key header. Read-only data endpoints (health, channels, attribution,
# model-performance, kpis, root) remain public. When unset, all endpoints are open.
API_KEY=

# Optional: Comma-separated list of allowed CORS origins for the API.
# In production, set this to your actual frontend domain(s).
# Example: CORS_ORIGINS=https://app.example.com,https://admin.example.com
# If unset, defaults to localhost development origins (8501, 3000, 8000).
# WARNING: Never use "*" in production.
CORS_ORIGINS=
